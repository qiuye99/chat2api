# ============================================================
# ChatGPT2API 配置
# ============================================================

# ChatGPT Access Token（必填）
# 获取方式：登录 chatgpt.com → 访问 https://chatgpt.com/api/auth/session → 复制 accessToken
CHATGPT_ACCESS_TOKEN=

# ChatGPT Session Token（可选，推荐）/ Optional session cookie for automatic token renewal
# 同一页面 JSON 中的 sessionToken。配置后 Access Token 过期时自动续期，可只填这一项
CHATGPT_SESSION_TOKEN=

# 续期后的 Token 和轮换后的 cookie 保存位置（启动时优先于 .env）/ Where renewed credentials are stored
SESSION_FILE=session.json

# 会话刷新页面的对外地址（可选，留空则用请求地址）/ Public base URL of the session refresh page
SESSION_REFRESH_BASE_URL=

# 出站代理（必填，需能访问 chatgpt.com）
# 支持 http / https / socks5
PROXY_URL=http://127.0.0.1:7890

# ChatGPT 地址（一般不需要改）
CHATGPT_BASE_URL=https://chatgpt.com

# 服务端口
PORT=8700

# 请求超时（秒）
TIMEOUT=600

# 图片生成使用的模型
WEB_IMAGE_MODEL=gpt-5-5-thinking

# 对话默认模型
WEB_CHAT_MODEL=gpt-4o
